# =============================================================================
# Diwan Media Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# All settings are optional unless marked [REQUIRED].
# =============================================================================

# ---------------------------------------------------------------------------
# API Keys [REQUIRED for Explore, Suggestions, and subtitle search]
# ---------------------------------------------------------------------------

# TMDB (The Movie Database) — used for movie/series search, posters, metadata.
# Get a free API Read Access Token at: https://www.themoviedb.org/settings/api
# 1. Create a free TMDB account
# 2. Go to Settings → API → Request an API Key (choose "Developer")
# 3. Copy the "API Read Access Token (v4 auth)" — it starts with "eyJ..."
TMDB_TOKEN=

# OMDb (Open Movie Database) — alternative movie search engine.
# Get a free API key at: https://www.omdbapi.com/apikey.aspx
# Choose the FREE tier (1,000 requests/day).
OMDB_API_KEY=

# OpenSubtitles — subtitle search and download.
# Get API credentials at: https://www.opensubtitles.com/en/consumers
# 1. Create a free account
# 2. Go to https://www.opensubtitles.com/en/consumers
# 3. Create a new "Consumer" (application) — note the API Key
# 4. Use your account username/password below
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_API_KEY=

# ---------------------------------------------------------------------------
# Network [OPTIONAL]
# ---------------------------------------------------------------------------

# Port the web portal listens on (default: 8080)
PORT=8080

# Internal API host and port (default: 127.0.0.1:8081)
MEDIA_API_HOST=127.0.0.1
MEDIA_API_PORT=8081

# Custom local domain name for network access.
# Use a .local name (e.g. "diwan.local") — mDNS automatically advertises it
# so any device on your network can reach the server without manual config.
# DOMAIN=diwan.local

# Enable scraper-based download adapters (default: 0).
# Set to 1 only if you have the local scraper files installed.
# See LOCAL_SETUP.md for details.
# EXPERIMENTAL=0

# ---------------------------------------------------------------------------
# Storage [OPTIONAL]
# ---------------------------------------------------------------------------

# Comma-separated list of media root folders to scan.
# When running as a native Windows app, all drives are scanned by default.
# MEDIA_ROOTS=D:\Movies,E:\Series

# Custom data directory (default: %LOCALAPPDATA%\LocalMediaServer)
# DATA_DIR=C:\DiwanData

# ---------------------------------------------------------------------------
# Scraper base URLs [OPTIONAL — only change if providers move domains]
# ---------------------------------------------------------------------------

# LARROZA_BASE_URL=https://larroza.lat
# AETHER_BASE_URL=https://aether.bar
# HDTODAY_BASE_URL=https://hdtoday.tr
# RAMOFLIX_BASE_URL=https://ramoflix.net
# SHAHID_BASE_URL=https://shhahhid4u.com
# SHUTTLETV_BASE_URL=https://shuttletv.su
# SOAP2DAY_BASE_URL=https://soap2dayhd.net

# ---------------------------------------------------------------------------
# Debug [OPTIONAL]
# ---------------------------------------------------------------------------

# Set to 1 to enable verbose debug logging
# MEDIA_DEBUG_LOGS=0
